{
  "name": "mogiri",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npx -y pnpm@10 --filter @mogiri/app dev",
    "dev:renderer": "npx -y pnpm@10 --filter @mogiri/renderer dev",
    "build": "npx -y pnpm@10 -r build",
    "typecheck": "npx -y pnpm@10 -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
